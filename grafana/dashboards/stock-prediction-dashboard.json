      "targets": [
        {
          "dataset": "",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-app-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH price_with_direction AS (\n  SELECT\n    id,\n    symbol,\n    date,\n    close,\n    LEAD(close) OVER (PARTITION BY symbol ORDER BY date) AS next_close,\n    CASE WHEN LEAD(close) OVER (PARTITION BY symbol ORDER BY date) > close\n         THEN 1 ELSE 0 END AS actual_up\n  FROM \"RawStockData\"\n),\nlatest_pred AS (\n  SELECT\n    raw_stock_data_id,\n    prediction,\n    predicted_at,\n    model_name,\n    ROW_NUMBER() OVER (PARTITION BY raw_stock_data_id ORDER BY predicted_at DESC) AS rn\n  FROM \"PredictionResults\"\n)\nSELECT\n  date_trunc('day', p.predicted_at) AS \"time\",\n  100.0 * AVG(CASE WHEN p.prediction = d.actual_up THEN 1 ELSE 0 END) AS accuracy_pct\nFROM latest_pred p\nJOIN price_with_direction d ON d.id = p.raw_stock_data_id\nWHERE p.rn = 1 AND d.next_close IS NOT NULL\n  AND $__timeFilter(p.predicted_at)\nGROUP BY 1\nORDER BY 1;\n",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Prediction Accuracy Over Time",
      "type": "timeseries"
