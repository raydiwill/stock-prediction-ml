# Environment configuration template
# Copy to config.env.dev / config.env.prod / config.env.local and adapt.
# Values below are dev-shaped defaults; comments flag what to change for prod.

# Database
POSTGRES_DB=dev
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
# prod: use strong, unique creds
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# MLflow tracking server
MLFLOW_TRACKING_URI=http://mlflow:5000

# API Keys
MARKETSTACK_API_KEY=your_api_key_here

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=debug
# prod: API_LOG_LEVEL=info, API_RELOAD=false
API_RELOAD=true

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
# GRAFANA_DB_* feed the Postgres datasource provisioning; prod: match POSTGRES_*
GRAFANA_DB_HOST=db
GRAFANA_DB_PORT=5432
GRAFANA_DB_NAME=${POSTGRES_DB}
GRAFANA_DB_USER=${POSTGRES_USER}
GRAFANA_DB_PASSWORD=${POSTGRES_PASSWORD}

# Airflow admin user (created by airflow-init, only on first startup)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@localhost
# Fixed Fernet key shared by airflow-init and airflow so encrypted Variables/
# Connections written by one can be decrypted by the other. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me_generate_a_real_fernet_key

# Feast feature store (Redis online store + PostgreSQL registry)
FEAST_REDIS_CONNECTION_STRING=redis:6379
FEAST_REGISTRY_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Model Serving
# prod: consider a distinct experiment name, e.g. Stock_Prediction_Experiment_Prod
DEFAULT_EXPERIMENT_NAME=Stock_Prediction_Experiment

# Feature casting (SQLite returns int64, model expects int32)
INT_COLUMNS=["day_of_month", "day_of_week", "month"]

# Supported stock symbols
VALID_SYMBOLS=["AAPL", "MSFT", "AMZN", "NVDA", "GOOGL", "META", "TSLA"]

# CORS
# prod: restrict to your actual domains, e.g. ["https://app.yourcompany.com"]
CORS_ORIGINS=["*"]

# Storage (MinIO / S3)
# Single bucket shared across environments, scoped by env-prefix
# dev: s3://stock-prediction/dev
# prod: s3://stock-prediction/prod
DATA_ROOT=s3://stock-prediction/dev

# MinIO credentials (used by minio-init service and applications)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
# prod: use strong, unique credentials

# S3 / MinIO client configuration
S3_ENDPOINT_URL=http://minio:9000
# prod: https://s3-endpoint.yourdomain.com or internal minio URL
# Read by the MLflow client (mlflow.pyfunc.load_model) to fetch artifacts from MinIO
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
# prod: match MINIO_ROOT_USER/PASSWORD
