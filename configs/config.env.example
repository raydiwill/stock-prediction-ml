# Database
DATABASE_URL=the_db_url

# MLflow
MLFLOW_TRACKING_URI=mlflow_url

# API Keys
MARKETSTACK_API_KEY=your_api_key_here

# API Server
API_HOST=api_server_host_here
API_PORT=api_server_port_here
API_LOG_LEVEL=info_for_prod/debug_for_dev
API_RELOAD=true_for_dev/false_for_prod

# Model Serving
DEFAULT_EXPERIMENT_NAME=the_default_mlflow_expriement_name_here

# CORS
CORS_ORIGINS=*