# Database
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dev

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# API Keys
MARKETSTACK_API_KEY=your_api_key_here

# API Server
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=debug
API_RELOAD=true

# Feast (Redis online store)
FEAST_REDIS_HOST=localhost
FEAST_REDIS_PORT=6379

# Monitoring (Pushgateway for batch metrics)
PUSHGATEWAY_URL=http://localhost:9091

# Model Serving
DEFAULT_EXPERIMENT_NAME=Stock_Prediction_Experiment

# Feature casting (SQLite returns int64, model expects int32)
INT_COLUMNS=["day_of_month", "day_of_week", "month"]

# Supported stock symbols
VALID_SYMBOLS=["AAPL", "MSFT", "AMZN", "NVDA", "GOOGL", "META", "TSLA"]

# CORS
CORS_ORIGINS=["*"]