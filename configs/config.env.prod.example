# Production environment configuration example
# Copy this file to config.env.prod and fill in with real values

# Database
# POSTGRES_USER/PASSWORD/DB are source-of-truth for docker-compose.prod.yml
POSTGRES_DB=stocks
POSTGRES_USER=stock_prod
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+psycopg2://stock_prod:change_me_in_production@db:5432/stocks

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# API Keys
MARKETSTACK_API_KEY=your_prod_key_here

# Airflow admin user (created by airflow-init, only on first startup)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_in_production
AIRFLOW_ADMIN_EMAIL=admin@company.com

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_RELOAD=false

# Feast feature store (Redis online store + PostgreSQL registry)
FEAST_REDIS_CONNECTION_STRING=redis:6379
FEAST_REGISTRY_URL=postgresql+psycopg2://stock_prod:change_me_in_production@db:5432/stocks

# Model Serving
DEFAULT_EXPERIMENT_NAME=Stock_Prediction_Experiment_Prod

# CORS — restrict to your domains in production
CORS_ORIGINS=["https://app.yourcompany.com"]
